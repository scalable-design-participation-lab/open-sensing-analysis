# macOS
.DS_Store
**/.DS_Store

# Python
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.python-version

# Jupyter
.ipynb_checkpoints/

# Street view images and per-point segmentation JSON (thousands of files)
data/kriging_street_view/streetview_images/
data/kriging_street_view/streetview_images 2/
data/kriging_street_view/Images/
data/kriging_street_view/built_environment/

# Ignore plain .json (per-point results), but keep .geojson
data/**/*.json
!data/**/*.geojson

# Large source downloads (re-downloadable)
data/**/*.zip
data/**/tl_2025_*_unzipped/
data/**/Annual_NLCD_*/

# Large model weights
*.pt
*.pth

# Map output images (regenerable)
data/**/*.png

# Keep essential spatial data
!data/**/*.geojson
!data/**/*.tif
!data/**/*.tiff
!data/**/*.csv
!data/**/*.gpkg

# 3D map exports with base64-embedded street view imagery (hundreds of MB, regenerable)
data/**/visualizations/*.html

# Generated project-graph view (regenerate with scripts/graph_view.py)
project_graph.html

# Raw EPA daily downloads (hundreds of MB, re-downloadable from EPA AQS)
data/2026_08_26_sensor_comparisons/data/daily_*.csv

# Street view imagery per site (thousands of files)
data/2026_08_03_imagery_quality_assessment/**/*.jpg
data/2026_09_16_site_built_environment_comparison/**/*.jpg

# Notebook caches (regenerable)
notebooks/**/cache/

# Monterrey pipeline: participant names and home locations (not for a public repo)
notebooks/monterrey_temp_hum/

# Local secrets, editor settings and personal tools
.env
.vscode/
scripts/time_ledger.py
scripts/time_ledger_projects.json
